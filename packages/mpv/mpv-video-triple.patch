 static void update_hook_opts_dynamic(struct priv *p, const struct pl_hook *hook,
                                      const struct mp_image *mpi);
+
+// Keep the source and scaling cache at one panel's size. Only the final
+// presentation is repeated; decoding and the filter chain remain unchanged.
+static bool render_frame(struct priv *p, const struct pl_frame_mix *mix,
+                         const struct pl_frame *image,
+                         const struct pl_frame *target,
+                         const struct pl_render_params *params)
+{
+    if (!p->next_opts->video_triple)
+        return mix ? pl_render_image_mix(p->rr, mix, target, params)
+                   : pl_render_image(p->rr, image, target, params);
+
+    struct pl_render_params local = *params;
+    local.skip_caching_single_frame = false;
+    p->collect_triple_perf = true;
+    p->triple_perf_started[0] = p->triple_perf_started[1] = false;
+    const float x0 = target->crop.x0, width = pl_rect_w(target->crop);
+    bool ok = true;
+    for (int i = 0; i < 3; i++) {
+        struct pl_frame tile = *target;
+        tile.crop.x0 = x0 + width * i / 3;
+        tile.crop.x1 = x0 + width * (i + 1) / 3;
+        // Clear borders once, and draw window-relative subtitles/OSD last.
+        if (i > 0)
+            local.border = PL_CLEAR_SKIP;
+        if (i < 2)
+            tile.num_overlays = 0;
+        ok = mix ? pl_render_image_mix(p->rr, mix, &tile, &local)
+                 : pl_render_image(p->rr, image, &tile, &local);
+        if (!ok)
+            break;
+    }
+    p->collect_triple_perf = false;
+    return ok;
+}
 
